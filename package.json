{
  "name": "lifecourse-assessment",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "人生选择指南 - 性格原型与职业方向趣味测评",
  "scripts": {
    "dev": "vite",
    "mock:api": "node scripts/mock-server.mjs",
    "build": "npm run sync:shared && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --exclude \"src/test/backend.integration.test.ts\"",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sync:shared": "node scripts/sync-shared.mjs",
    "hash:password": "node scripts/hash-password.mjs",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "fn:deploy": "supabase functions deploy start-test submit-test retake create-share shared-result get-result admin-login admin-list-codes admin-create-code admin-update-code admin-stats --no-verify-jwt",
    "pretest:integration": "node scripts/check-integration-env.mjs",
    "test:integration": "vitest run src/test/backend.integration.test.ts",
    "test:integration:allow-skip": "ALLOW_INTEGRATION_SKIP=1 npm run test:integration",
    "test:all": "vitest run"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@esbuild/darwin-x64": "^0.25.12",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.1.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  }
}
